# Copy this file to `.env` for local debugging.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
S2_KEY=
GITHUB_TOKEN=
# X / Twitter source — choose ONE:
#   TWITTERAPI_IO_KEY: managed provider (recommended). ~$0.15/1k tweets, no X developer account
#     needed, works for new accounts. Get a key at https://twitterapi.io
#   X_BEARER_TOKEN: official X API v2 (legacy fallback; Basic ~$200/mo, new devs may be unable to
#     subscribe). Used only if TWITTERAPI_IO_KEY is unset.
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=
SLACK_KEY=
SLACK_CHANNEL_ID=
