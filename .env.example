# Copy this file to `.env` for local debugging.

# OPENAI_API_KEY / OPENAI_BASE_URL: LEGACY OPT-IN, not required.
#   Model calls go through arxiv_assistant/utils/llm_gateway.py, whose default
#   `[LLM] backend = auto` uses the keyless llmcall chain (codexg -> codex -> cc ->
#   claude) or this repo's own `claude -p` transport. `auto` never selects OpenAI.
#   Set these ONLY if you also set `[LLM] backend = openai` in configs/config.ini.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
S2_KEY=
GITHUB_TOKEN=
# X / Twitter source — choose ONE:
#   TWITTERAPI_IO_KEY: managed provider (recommended). ~$0.15/1k tweets, no X developer account
#     needed, works for new accounts. Get a key at https://twitterapi.io
#   X_BEARER_TOKEN: official X API v2 (legacy fallback; Basic ~$200/mo, new devs may be unable to
#     subscribe). Used only if TWITTERAPI_IO_KEY is unset.
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=
SLACK_KEY=
SLACK_CHANNEL_ID=
